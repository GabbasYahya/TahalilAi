#!/bin/bash
# Pre-commit hook: block commits containing potential secrets
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -e

# Patterns that indicate hardcoded secrets
SECRET_PATTERNS=(
    'AIza[0-9A-Za-z_-]{35}'            # Google API keys
    'sk-[A-Za-z0-9]{20,}'               # OpenAI keys
    'ghp_[A-Za-z0-9]{36}'               # GitHub PATs
    'AKIA[0-9A-Z]{16}'                   # AWS access keys
    'xox[bporsea]-[A-Za-z0-9-]+'        # Slack tokens
    'smtp_app_password\s*=\s*["\x27][^"\x27]{8,}'  # SMTP passwords
    'whatsapp_access_token\s*=\s*["\x27][^"\x27]{8,}'  # WhatsApp tokens
)

FAILED=0

for pattern in "${SECRET_PATTERNS[@]}"; do
    # Check only staged files (not the full repo)
    MATCHES=$(git diff --cached --diff-filter=ACMR -U0 | grep -iP "$pattern" 2>/dev/null || true)
    if [ -n "$MATCHES" ]; then
        echo "ERROR: Potential secret detected in staged changes!"
        echo "Pattern: $pattern"
        echo "Match: $MATCHES"
        echo ""
        FAILED=1
    fi
done

# Also check for .env files being staged
ENV_FILES=$(git diff --cached --name-only --diff-filter=ACR | grep -E '^\.env$|\.env\.' | grep -v '\.example' || true)
if [ -n "$ENV_FILES" ]; then
    echo "ERROR: .env file(s) staged for commit!"
    echo "$ENV_FILES"
    FAILED=1
fi

if [ "$FAILED" -eq 1 ]; then
    echo ""
    echo "Commit blocked. Remove secrets before committing."
    echo "If this is a false positive, use: git commit --no-verify"
    exit 1
fi

exit 0
