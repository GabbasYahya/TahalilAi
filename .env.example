# ── Gemini Translation ─────────────────────────────────────────────────────
# Get your API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# ── Tesseract OCR ──────────────────────────────────────────────────────────
# Set this if Tesseract is not on your system PATH.
# Windows example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Server ─────────────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000

# ── LLM ────────────────────────────────────────────────────────────────────
# Relative paths from the backend/ directory
# LLAMA_CLI=bin/llama-cli.exe
# LLM_MODEL=Models/Ministral-3-3B-Instruct-2512-Q5_K_M.gguf
# MODEL_TIMEOUT=600

# ── OCR Language Pack ──────────────────────────────────────────────────────
# OCR_LANGUAGES=fra+eng+ara
