# ── Environment ─────────────────────────────────────────────────────────
# development | staging | production
ENVIRONMENT=development

# ── Gemini Translation ─────────────────────────────────────────────────────
# Get your API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# ── CORS (required in production — JSON list of allowed origins) ───────
# In development: allows localhost. In production: set to your frontend domain.
CORS_ORIGINS=["http://localhost:3000"]

# ── Tesseract OCR ──────────────────────────────────────────────────────────
# Set this if Tesseract is not on your system PATH.
# Windows example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Server ─────────────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000

# ── LLM ────────────────────────────────────────────────────────────────────
# Relative paths from the backend/ directory
# LLAMA_CLI=bin/llama-cli.exe
# LLM_MODEL=Models/Ministral-3-3B-Instruct-2512-Q5_K_M.gguf
# MODEL_TIMEOUT=600

# ── OCR Language Pack ──────────────────────────────────────────────────────
# OCR_LANGUAGES=fra+eng+ara

# ── Google Maps (optional - for geocoding and ratings) ──────────────────────
# Get your API key at https://console.cloud.google.com/apis/credentials
# Enable: Geocoding API + Places API
# Free tier: $200/month (~40K geocoding requests)
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# Step 1: Enable 2-Step Verification on your Google account
# Step 2: Go to https://myaccount.google.com/apppasswords
# Step 3: Generate a 16-character App Password for "Mail"
# Step 4: Paste it below (with or without the spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SENDER_EMAIL=your.email@gmail.com
SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── WhatsApp (Cloud API) ─────────────────────────────────────────────────────
# Step 1: Create a Meta Developer account at https://developers.facebook.com
# Step 2: Create a Business app > Add WhatsApp product
# Step 3: Go to WhatsApp > API Setup to find your Phone Number ID and Token
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_VERSION=v19.0
